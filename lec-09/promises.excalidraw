      "text": "{\n  \"type\": \"excalidraw\",\n  \"version\": 2,\n  \"source\": \"https://marketplace.visualstudio.com/items?itemName=pomdtr.excalidraw-editor\",\n  \"elements\": [\n    {\n      \"id\": \"GsjBakDOUwM8MP-OzUbRe\",\n      \"type\": \"text\",\n      \"x\": 234,\n      \"y\": 141,\n      \"width\": 527.0596313476562,\n      \"height\": 150,\n      \"angle\": 0,\n      \"strokeColor\": \"#1e1e1e\",\n      \"backgroundColor\": \"transparent\",\n      \"fillStyle\": \"solid\",\n      \"strokeWidth\": 2,\n      \"strokeStyle\": \"solid\",\n      \"roughness\": 1,\n      \"opacity\": 100,\n      \"groupIds\": [],\n      \"frameId\": null,\n      \"index\": \"a1\",\n      \"roundness\": null,\n      \"seed\": 151634039,\n      \"version\": 201,\n      \"versionNonce\": 388955961,\n      \"isDeleted\": false,\n      \"boundElements\": [],\n      \"updated\": 1771906323102,\n      \"link\": null,\n      \"locked\": false,\n      \"text\": \"promises -> a set of async code which willl either get \\n               exectued successfully or not.\\n\\nit has three states -> 1. pending\\n                            2. fullfilled\\n                            3. rejected \",\n      \"fontSize\": 20,\n      \"fontFamily\": 5,\n      \"textAlign\": \"left\",\n      \"verticalAlign\": \"top\",\n      \"containerId\": null,\n      \"originalText\": \"promises -> a set of async code which willl either get \\n               exectued successfully or not.\\n\\nit has three states -> 1. pending\\n                            2. fullfilled\\n                            3. rejected \",\n      \"autoResize\": true,\n      \"lineHeight\": 1.25\n    },\n    {\n      \"id\": \"zN5AEjLmD7FNQur7gXXjJ\",\n      \"type\": \"text\",\n      \"x\": 414.7282190435764,\n      \"y\": 385.2666878277865,\n      \"width\": 304.1597900390625,\n      \"height\": 75,\n      \"angle\": 0,\n      \"strokeColor\": \"#1e1e1e\",\n      \"backgroundColor\": \"transparent\",\n      \"fillStyle\": \"solid\",\n      \"strokeWidth\": 2,\n      \"strokeStyle\": \"solid\",\n      \"roughness\": 1,\n      \"opacity\": 100,\n      \"groupIds\": [],\n      \"frameId\": null,\n      \"index\": \"a2\",\n      \"roundness\": null,\n      \"seed\": 1490413881,\n      \"version\": 102,\n      \"versionNonce\": 2048312921,\n      \"isDeleted\": false,\n      \"boundElements\": [\n        {\n          \"id\": \"cA9ghvT2QVEk6xCfSGwue\",\n          \"type\": \"arrow\"\n        },\n        {\n          \"id\": \"57ykLG2nPh5dn66CJPLoB\",\n          \"type\": \"arrow\"\n        }\n      ],\n      \"updated\": 1771906370069,\n      \"link\": null,\n      \"locked\": false,\n      \"text\": \"new Promise((resolve,reject)=>{\\n    async code.\\n})\",\n      \"fontSize\": 20,\n      \"fontFamily\": 5,\n      \"textAlign\": \"left\",\n      \"verticalAlign\": \"top\",\n      \"containerId\": null,\n      \"originalText\": \"new Promise((resolve,reject)=>{\\n    async code.\\n})\",\n      \"autoResize\": true,\n      \"lineHeight\": 1.25\n    },\n    {\n      \"id\": \"cA9ghvT2QVEk6xCfSGwue\",\n      \"type\": \"arrow\",\n      \"x\": 577.4250033673111,\n      \"y\": 382.67980594084554,\n      \"width\": 18.239647889153048,\n      \"height\": 31.785355067572084,\n      \"angle\": 0,\n      \"strokeColor\": \"#2f9e44\",\n      \"backgroundColor\": \"transparent\",\n      \"fillStyle\": \"solid\",\n      \"strokeWidth\": 2,\n      \"strokeStyle\": \"solid\",\n      \"roughness\": 1,\n      \"opacity\": 100,\n      \"groupIds\": [],\n      \"frameId\": null,\n      \"index\": \"a3\",\n      \"roundness\": {\n        \"type\": 2\n      },\n      \"seed\": 2024046103,\n      \"version\": 116,\n      \"versionNonce\": 1147225337,\n      \"isDeleted\": false,\n      \"boundElements\": null,\n      \"updated\": 1771906324488,\n      \"link\": null,\n      \"locked\": false,\n      \"points\": [\n        [\n          0,\n          0\n        ],\n        [\n          18.239647889153048,\n          -31.