     \"groupIds\": [],\n      \"frameId\": null,\n      \"index\": \"a6\",\n      \"roundness\": {\n        \"type\": 2\n      },\n      \"seed\": 1874093079,\n      \"version\": 40,\n      \"versionNonce\": 1397889239,\n      \"isDeleted\": false,\n      \"boundElements\": null,\n      \"updated\": 1771906371170,\n      \"link\": null,\n      \"locked\": false,\n      \"points\": [\n        [\n          0,\n          0\n        ],\n        [\n          18.166523927840558,\n          42.323721699123155\n        ]\n      ],\n      \"lastCommittedPoint\": null,\n      \"startBinding\": null,\n      \"endBinding\": {\n        \"elementId\": \"zN5AEjLmD7FNQur7gXXjJ\",\n        \"focus\": 0,\n        \"gap\": 8.616331728351327\n      },\n      \"startArrowhead\": null,\n      \"endArrowhead\": \"arrow\",\n      \"elbowed\": false\n    },\n    {\n      \"id\": \"ARe0H2tcQsEGVjigq23UQ\",\n      \"type\": \"text\",\n      \"x\": 652.018365405408,\n      \"y\": 453.57592983482726,\n      \"width\": 270.9798278808594,\n      \"height\": 50,\n      \"angle\": 0,\n      \"strokeColor\": \"#e03131\",\n      \"backgroundColor\": \"transparent\",\n      \"fillStyle\": \"solid\",\n      \"strokeWidth\": 2,\n      \"strokeStyle\": \"solid\",\n      \"roughness\": 1,\n      \"opacity\": 100,\n      \"groupIds\": [],\n      \"frameId\": null,\n      \"index\": \"a7\",\n      \"roundness\": null,\n      \"seed\": 1369771799,\n      \"version\": 96,\n      \"versionNonce\": 1486979993,\n      \"isDeleted\": false,\n      \"boundElements\": null,\n      \"updated\": 1771906395580,\n      \"link\": null,\n      \"locked\": false,\n      \"text\": \"this method is for rejection\\nof async code\",\n      \"fontSize\": 20,\n      \"fontFamily\": 5,\n      \"textAlign\": \"left\",\n      \"verticalAlign\": \"top\",\n      \"containerId\": null,\n      \"originalText\": \"this method is for rejection\\nof async code\",\n      \"autoResize\": true,\n      \"lineHeight\": 1.25\n    },\n    {\n      \"id\": \"qrC-2A4kzhiW-eRZ_jRDR\",\n      \"type\": \"text\",\n      \"x\": 306.5654357858449,\n      \"y\": 548.0568587302636,\n      \"width\": 488.2596740722656,\n      \"height\": 475,\n      \"angle\": 0,\n      \"strokeColor\": \"#1e1e1e\",\n      \"backgroundColor\": \"transparent\",\n      \"fillStyle\": \"solid\",\n      \"strokeWidth\": 2,\n      \"strokeStyle\": \"solid\",\n      \"roughness\": 1,\n      \"opacity\": 100,\n      \"groupIds\": [],\n      \"frameId\": null,\n      \"index\": \"a9\",\n      \"roundness\": null,\n      \"seed\": 2075078841,\n      \"version\": 5,\n      \"versionNonce\": 445062999,\n      \"isDeleted\": false,\n      \"boundElements\": [\n        {\n          \"id\": \"wWTnV2hugDKOE4qlIw9BU\",\n          \"type\": \"arrow\"\n        }\n      ],\n      \"updated\": 1771907963478,\n      \"link\": null,\n      \"locked\": false,\n      \"text\": \"const mypromise = new Promise((resolve,reject)=>{\\n  setTimeout(()=>{\\n    let num = Math.random()*10;\\n    if(num<5){\\n      resolve(`this promise is fulfilled ${num}`)\\n    }else{\\n      reject(`this promise is rejected ${num}`)\\n    }\\n    \\n  },2000)\\n})\\n\\nconsole.log(mypromise);\\n\\nmypromise.then((response)=>{\\n  console.log(response);\\n}).catch((err)=>{\\n  console.log(err);\\n})\",\n      \"fontSize\": 20,\n      \"fontFamily\": 5,\n      \"textAlign\": \"left\",\n      \"verticalAlign\": \"top\",\n      \"containerId\": null,\n      \"originalText\": \"const mypromise = new Promise((resolve,reject)=>{\\n  setTimeout(()=>{\\n    let num = Math.random()*10;\\n    if(num<5){\\n      resolve(`this promise is fulfilled ${num}`)\\n    }else{\\n      reject(`this promise is rejected ${num}`)\\n    }\\n    \\n  },2000)\\n})\\n\\nconsole.log(mypromise);\\n\\nmypromise.then((response)=>{\\n  console.log(response);\\n}).catch((err)=>{\\n  console.log(err);\\n})\",\n      \"autoResize\": true,\n      \"lineHeight\": 1.25\n    },\n    {\n      \"id\": \"rExZ2qXbRADbhXPq3czen\",\n      \"type\": \"freedraw\",\n      \"x\": 461.40045862998414,\n      \"y\": 907.841836440956,\n      \"width\": 128.92730349522816,\n      \"height\": 21.536972616196408,\n      \"angle\": 0,\n      \"strokeColor\": \"#e03131\",\n      \"backgroundColor\": \"transparent\",\n      \"fillStyle\": \"solid\",\n      \"strokeWidth\": 2,\n      \"strokeStyle\": \"solid\",\n      \"roughness\": 1,\n      \"opacity\": 20,\n      \"groupIds\": [],\n      \"frameId\": null,\n      \"index\": \"aC\",\n      \"roundness\": null,\n      \"seed\": 338525911,\n      \"version\": 248,\n      \"versionNonce\": 1716023895,\n      \"isDeleted\": false,\n      \"boundElements\": null,\n      \"updated\": 1771907791592,\n      \"link\": null,\n      \"locked\": false,\n      \"points\": [\n        [\n          0,\n          0\n        ],\n        [\n          0.008335817036368098,\n          -0.0861367760420535\n        ],\n        [\n          0.3223182587381075,\n          -0.172273552084107\n        ],\n        [\n          1.1920218361951243,\n          -0.172273552084107\n        ],\n        [\n          3.459364070076731,\n          -0.172273552084107\n        ],\n        [\n          8.294137951147775,\n          -0.172273552084107\n        ],\n        [\n          15.21842330265872,\n          -0.172273552084107\n        ],\n        [\n          21.28689810510656,\n          -0.172273552084107\n        ],\n        [\n          25.785460699045643,\n          -0.172273552084107\n        ],\n        [\n          29.556028605145286,\n          -0.172273552084107\n        ],\n        [\n          32.848676334495394,\n          -0.172273552084107\n        ],\n        [\n          36.47753535097746,\n          -0.172273552084107\n        ],\n        [\n          40.712130405432845,\n          -0.172273552084107\n        ],\n        [\n          45.11066319493597,\n          -0.022228845430163346\n        ],\n        [\n          48.94236042596873,\n          0.188945186156